# Example configuration; not loaded automatically by Node.js.
PORT=8080
APP_ENV=local
APP_VERSION=1.0.0
BUILD_SHA=local

# Optional fault injection (milliseconds from process startup):
DEMO_STARTUP_DELAY_MS=0
DEMO_READINESS_DELAY_MS=0
# Empty = disabled. Set to 0 to activate immediately.
DEMO_LIVENESS_FAIL_AFTER_MS=
DEMO_READINESS_FAIL_AFTER_MS=
